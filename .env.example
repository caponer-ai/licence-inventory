# Copy to .env and fill in. .env is gitignored and never committed.

# local or production. production switches on HTTPS, HSTS, secure cookies
# and makes DJANGO_SECRET_KEY mandatory.
DJANGO_ENV=local
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required when DJANGO_ENV=production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Set POSTGRES_DB to use Postgres, otherwise SQLite.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Request rate limits.
THROTTLE_ANON=20/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=5/min
