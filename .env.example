# Скопіювати в .env і заповнити. .env у .gitignore, у репозиторій не потрапляє.

# local або production. production вмикає HTTPS, HSTS, secure-cookies
# і робить DJANGO_SECRET_KEY обовʼязковим.
DJANGO_ENV=local
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Обовʼязковий при DJANGO_ENV=production. Згенерувати:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Задано POSTGRES_DB - йдемо в Postgres, інакше SQLite.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Обмеження частоти запитів.
THROTTLE_ANON=20/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=5/min
