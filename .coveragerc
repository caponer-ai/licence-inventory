[run]
source = inventory,config
omit =
    */migrations/*
    */tests/*
    config/wsgi.py
    manage.py

[report]
# Coverage is an indicator, not a goal. The threshold is here so that a
# drop shows up in CI together with its cause, not to produce a nice number.
#
# It deliberately stops short of 100. The uncovered lines in config/settings.py
# only run under DJANGO_ENV=production: they are checked by tests in
# tests/test_settings.py, but those spawn a separate process and coverage does
# not look into child processes. Putting a pragma there would hide the truth
# instead of explaining it.
fail_under = 97
show_missing = true
skip_covered = true
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if TYPE_CHECKING:
